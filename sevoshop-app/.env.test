# ============================================================
# .env.test — Environment untuk menjalankan test (Playwright)
# ------------------------------------------------------------
# Dipakai saat suite E2E dijalankan. Sebagian besar alur (login,
# cart, checkout, dashboard) memakai page.route() mock + storageState,
# jadi tidak memanggil backend. Namun halaman yang fetch di SERVER
# (mis. "/" dan "/products") tetap memakai URL di bawah ini.
# ============================================================

# Backend Flask SevoShop (Render) — kini stabil.
NEXT_PUBLIC_API_BASE_URL=https://sevoshop.onrender.com
