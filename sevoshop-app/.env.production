# ============================================================
# .env.production — Environment untuk build produksi
# ------------------------------------------------------------
# Dimuat otomatis oleh Next.js saat `next build` (mode production).
# CATATAN: saat deploy ke Vercel, nilai sebenarnya diambil dari
# Environment Variables di dashboard Vercel, BUKAN dari file ini.
# File ini berfungsi sebagai dokumentasi nilai produksi dan
# fallback saat menjalankan `next build && next start` secara lokal.
# ============================================================

# Backend Flask SevoShop (Render) — API produksi.
NEXT_PUBLIC_API_BASE_URL=https://sevoshop.onrender.com
